{
  "name": "fuel-mood-web",
  "description": "Fuel Mood: a price-mood map of EU-27 fuel prices from the European Commission Weekly Oil Bulletin.",
  "license": "MIT",
  "private": true,
  "version": "0.1.0",
  "type": "module",
  "engines": {
    "node": ">=20.19"
  },
  "scripts": {
